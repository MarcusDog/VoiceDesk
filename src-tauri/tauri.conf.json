{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceDesk",
  "version": "0.5.0",
  "identifier": "com.voicedesk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoiceDesk",
        "width": 1440,
        "height": 900,
        "minWidth": 680,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**"]
      },
      "csp": "default-src 'self'; img-src 'self' asset: data:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "../dist-asr/voicedesk-asr",
      "../runtime/llama"
    ]
  }
}
